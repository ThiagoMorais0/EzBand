# o conteudo deste arquivo deve ser copiado para um arquivo chamado .env na raiz do projeto
# e os seus atributos preenchidos
#
# OBS: o arquivo .env está no gitignore e não deve subir para o git.
# Utilizar este como base e preencher os valores corretos
#
# POSTGRES
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=database
# JWT
JWT_SECRET=mysecretkey
# MINIO
MINIO_ADMIN_USER=minioadm
MINIO_ADMIN_PASSWORD=1@3$5¨7*
# MONGO
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
MONGO_DB_DATABASE=chat